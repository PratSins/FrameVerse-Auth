PORT=8081
ENVIRONMENT=development

# Database Connection (Cloud SQL Proxy or Local PostgreSQL)
DATABASE_URL=postgres://postgres:your_password_here@localhost:5432/frameverse_auth?sslmode=disable

# Token Expiry Settings
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7

# Optional RSA Keys (If omitted, a secure 2048-bit RSA key pair is generated automatically on startup)
RSA_PRIVATE_KEY_PATH=
RSA_PUBLIC_KEY_PATH=
RSA_PRIVATE_KEY_PEM=
RSA_PUBLIC_KEY_PEM=
